{
  "name": "soundcloud-player",
  "productName": "Cloudplayer",
  "version": "0.1.0",
  "private": true,
  "description": "A Spotify-style desktop client for SoundCloud (personal use).",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "smoke": "SMOKE=1 vitest run src/main",
    "dist": "electron-vite build && electron-builder --mac"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@tanstack/react-query": "^5.104.0",
    "hls.js": "^1.7.3",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "~4.0.18"
  },
  "build": {
    "appId": "dev.local.cloudplayer",
    "productName": "Cloudplayer",
    "directories": {
      "buildResources": "resources",
      "output": "dist"
    },
    "files": [
      "out/**"
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": "dmg"
    }
  }
}
